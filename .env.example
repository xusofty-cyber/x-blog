# Database connection URL for PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@nexasx-postgres:5432/x_blog?schema=public

# JWT secret key for signing tokens
JWT_SECRET=CHANGE_ME

# Initial admin credentials for prisma/seed.ts (leave empty to skip admin creation)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Internal API URL for SSR and Next.js rewrites
API_INTERNAL_URL=http://localhost:4000

# Public site URL (SEO, Sitemap, RSS)
NEXT_PUBLIC_SITE_URL=https://blog.ulife.vip

# Mail admin (QQ IMAP auth codes, AES-256-GCM): 32-byte base64, server .env only,
# never commit a real value. Generate on the server with python3, not in chat:
# python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MAIL_ENCRYPTION_KEY=
