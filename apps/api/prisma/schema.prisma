generator client {
  provider = "prisma-client-js"
  // 部署镜像为 Alpine + OpenSSL 3.x：生成时必须固定该引擎变体，否则构建期
  // （无 openssl）会生成 linux-musl 通用引擎，运行期检测到 openssl-3.0.x 后
  // 找不到对应引擎文件、PrismaService 判定数据库不可达（2026-10-24 服务器实测）
  binaryTargets = ["linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  posts        Post[]
}

model Category {
  id    String @id @default(uuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(uuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  excerpt     String
  content     String
  coverImage  String?
  status      PostStatus  @default(DRAFT)
  publishedAt DateTime?
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags        Tag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  viewCount   Int         @default(0)
  isPinned    Boolean     @default(false)
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 后台邮箱切换（v1，只读）：只存账号与加密后的 QQ 邮箱授权码，
// 不在博客库里存邮件正文与附件；邮件每次打开时按需经 IMAP 拉取。
// v2：一个 QQ 分组下最多 3 个邮箱（数字、字母、Foxmail 各一），
// 切换列表按 QQ 分组展示，免得记某个邮箱属于哪个 QQ。
model QqGroup {
  id                String        @id @default(uuid())
  label             String
  // 一个 QQ 下的数字、字母、Foxmail 三个邮箱共用同一个 QQ 邮箱授权码，
  // 所以授权码只存在分组上，不再按邮箱各存一份
  encryptedAuthCode String
  mailAccounts      MailAccount[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model MailAccount {
  id                String    @id @default(uuid())
  label             String
  email             String    @unique
  imapHost          String    @default("imap.qq.com")
  imapPort          Int       @default(993)
  username          String
  qqGroupId         String
  qqGroup           QqGroup   @relation(fields: [qqGroupId], references: [id], onDelete: Cascade)
  // numeric = 数字 QQ 邮箱，letter = 字母 QQ 邮箱，foxmail = Foxmail 邮箱
  mailboxType       String    @default("numeric")
  lastTestedAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([qqGroupId])
}

// 后台优惠雷达（Perks Radar）：只存轻量线索索引（标题、规范化链接、短摘要、时间与状态），
// 不抓原文正文，不暴露前台，仅限管理员后台使用。
model PerkRound {
  id         String          @id @default(uuid())
  trigger    String
  status     String
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  sourceRuns PerkSourceRun[]
  items      PerkItem[]

  @@index([startedAt])
  @@index([trigger, startedAt])
}

model PerkSourceRun {
  id            String    @id @default(uuid())
  roundId       String
  round         PerkRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sourceId      String
  ok            Boolean
  notModified   Boolean   @default(false)
  fetchedCount  Int       @default(0)
  insertedCount Int       @default(0)
  error         String?
  finalUrl      String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([roundId])
  @@index([sourceId, startedAt])
}

model PerkSourceState {
  sourceId            String    @id
  etag                String?
  lastModified        String?
  lastFetchedAt       DateTime?
  lastOkAt            DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

model PerkItem {
  id               String     @id @default(uuid())
  canonicalUrl     String     @unique
  url              String
  title            String
  summary          String     @default("")
  category         String
  sourceId         String
  publishedAt      DateTime?
  expiresAt        DateTime?
  firstSeenAt      DateTime   @default(now())
  firstSeenRoundId String?
  firstSeenRound   PerkRound? @relation(fields: [firstSeenRoundId], references: [id], onDelete: SetNull)
  isBookmarked     Boolean    @default(false)
  isClaimed        Boolean    @default(false)
  updatedAt        DateTime   @updatedAt

  @@index([sourceId, category])
  @@index([publishedAt])
  @@index([firstSeenAt])
  @@index([isBookmarked])
}

